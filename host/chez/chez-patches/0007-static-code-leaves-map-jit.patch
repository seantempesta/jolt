+
+#if defined(__APPLE__) && defined(__arm64__) && !defined(WRITE_XOR_EXECUTE_CODE)
+/* Static code leaves MAP_JIT (macOS arm64), when CHEZ_SHARE_STATIC_CODE=1.
+
+   fork() never shares a MAP_JIT mapping copy-on-write: XNU copies every
+   resident page of it into the child at the fork, so each child of a process
+   with a large code heap pays that whole heap, in memory and in fork latency.
+   Code in the static generation is never moved or written again, so it does
+   not need a writable mapping. After a collection into the static generation,
+   this replaces each run of static code segments, in place, with an r-x copy
+   of itself in ordinary anonymous memory, which fork shares copy-on-write.
+   Addresses do not change, so nothing is relocated.
+
+   The replacement is one vm_map operation (mach_vm_remap with
+   VM_FLAGS_OVERWRITE of a copy made executable beforehand), so the range holds
+   the same instructions at every instant. A thread may execute it during the
+   move: other Scheme threads are stopped, but one returning from a
+   __collect_safe foreign call runs its caller's code before it reactivates.
+
+   It is off unless CHEZ_SHARE_STATIC_CODE=1: under the hardened runtime,
+   executing code outside MAP_JIT needs the
+   com.apple.security.cs.allow-unsigned-executable-memory entitlement, and a
+   process without it is killed (SIGKILL) when it first runs a moved page. */
+#include <mach/mach.h>
+#include <mach/mach_vm.h>
+#include <libkern/OSCacheControl.h>
+
+static IBOOL code_range_writable(void *addr) {
+  mach_vm_address_t a = (mach_vm_address_t)addr; mach_vm_size_t s;
+  vm_region_basic_info_data_64_t b; mach_msg_type_number_t c = VM_REGION_BASIC_INFO_COUNT_64; mach_port_t o;
+  if (mach_vm_region(mach_task_self(), &a, &s, VM_REGION_BASIC_INFO_64, (vm_region_info_t)&b, &c, &o) != KERN_SUCCESS
+      || a > (mach_vm_address_t)addr)
+    return 0;
+  return (b.protection & VM_PROT_WRITE) != 0; /* MAP_JIT code reports rwx, moved code r-x */
+}
+
+/* Replaces [addr, addr + bytes) by an r-x copy of itself. Returns 0, with the
+   range untouched, when the copy cannot be made. */
+static IBOOL move_static_code_run(void *addr, uptr bytes) {
+  mach_vm_address_t target = (mach_vm_address_t)addr;
+  vm_prot_t cur, max;
+  kern_return_t kr;
+  void *tmp = mmap(NULL, bytes, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+  if (tmp == MAP_FAILED) return 0;
+  memcpy(tmp, addr, bytes);
+  sys_icache_invalidate(tmp, bytes);
+  if (mprotect(tmp, bytes, PROT_READ | PROT_EXEC) != 0) { munmap(tmp, bytes); return 0; }
+  kr = mach_vm_remap(mach_task_self(), &target, bytes, 0, VM_FLAGS_FIXED | VM_FLAGS_OVERWRITE,
+                     mach_task_self(), (mach_vm_address_t)tmp, TRUE, &cur, &max, VM_INHERIT_COPY);
+  munmap(tmp, bytes);
+  if (kr != KERN_SUCCESS || target != (mach_vm_address_t)addr) {
+    if (code_range_writable(addr)) return 0; /* the old mapping is still in place */
+    S_error_abort("share-static-code: replacing static code failed");
+  }
+  sys_icache_invalidate(addr, bytes);
+  return 1;
+}
+
+static int share_static_code_enabled = -1;
+
+void S_share_static_code(void) {
+  chunkinfo *chunk; ptr ls; iptr i, j, k;
+  if (share_static_code_enabled < 0) {
+    const char *e = getenv("CHEZ_SHARE_STATIC_CODE");
+    share_static_code_enabled = (e != NULL && e[0] == '1');
+  }
+  if (!share_static_code_enabled) return;
+
+  /* Close off every thread's static code allocation area, so no later
+     collection lays an end-of-segment marker into a moved segment. */
+  S_ENABLE_CODE_WRITE(1);
+  for (ls = S_threads; ls != Snil; ls = Scdr(ls)) {
+    ptr t_tc = (ptr)THREADTC(Scar(ls));
+    if (THREAD_GC(t_tc)->base_loc[static_generation][space_code])
+      S_close_off_thread_local_segment(t_tc, space_code, static_generation);
+  }
+  S_ENABLE_CODE_WRITE(0);
+
+  for (i = -1; i <= PARTIAL_CHUNK_POOLS; i++) {
+    for (chunk = (i < 0 ? S_code_chunks_full : S_code_chunks[i]); chunk != NULL; chunk = chunk->next) {
+      j = 0;
+      while (j < chunk->segs) {
+        /* a freed segment keeps its generation, so test the space as well */
+        k = j;
+        while (k < chunk->segs && chunk->sis[k].generation == static_generation && chunk->sis[k].space == space_code
+               && code_range_writable(TO_VOIDP(build_ptr(chunk->base + k, 0))))
+          k++;
+        if (k == j) { j++; continue; }
+        if (!move_static_code_run(TO_VOIDP(build_ptr(chunk->base + j, 0)), (k - j) * bytes_per_segment)) {
+          share_static_code_enabled = 0; /* this process cannot make code executable outside MAP_JIT */
+          return;
+        }
+        j = k;
+      }
+    }
+  }
+}
+#endif
