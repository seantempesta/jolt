  (let ((_lp$30449 jv$clojure.core/attach-core-doc-meta!) (_la$30450 "clojure.core") (_la$30451 "delay?") (_la$30452 "returns true if x is a Delay created with delay") (_la$30453 (jolt-list-pos 806 4 (jolt-vector (jolt-symbol #f "x"))))) (if (#3%procedure? _lp$30449) (_lp$30449 _la$30450 _la$30451 _la$30452 _la$30453 jolt-nil) (jolt-invoke _lp$30449 _la$30450 _la$30451 _la$30452 _la$30453 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$30454 jv$clojure.core/attach-core-doc-meta!) (_la$30455 "clojure.core") (_la$30456 "deliver") (_la$30457 "Delivers the supplied value to the promise, releasing any pending\n  derefs. A subsequent call to deliver on a promise will have no effect.") (_la$30458 (jolt-list-pos 810 4 (jolt-vector (jolt-symbol #f "promise") (jolt-symbol #f "val"))))) (if (#3%procedure? _lp$30454) (_lp$30454 _la$30455 _la$30456 _la$30457 _la$30458 jolt-nil) (jolt-invoke _lp$30454 _la$30455 _la$30456 _la$30457 _la$30458 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$30459 jv$clojure.core/attach-core-doc-meta!) (_la$30460 "clojure.core") (_la$30461 "denominator") (_la$30462 "Returns the denominator part of a Ratio.") (_la$30463 (jolt-list-pos 814 4 (jolt-vector (jolt-symbol #f "r")))) (_la$30464 (jolt-invoke1 (var-deref "jolt.host" "jolt-class-for") "java.math.BigInteger"))) (if (#3%procedure? _lp$30459) (_lp$30459 _la$30460 _la$30461 _la$30462 _la$30463 _la$30464) (jolt-invoke _lp$30459 _la$30460 _la$30461 _la$30462 _la$30463 _la$30464))))
(guard (e (#t #f))
  (let ((_lp$30465 jv$clojure.core/attach-core-doc-meta!) (_la$30466 "clojure.core") (_la$30467 "deref") (_la$30468 "Also reader macro: @ref/@agent/@var/@atom/@delay/@future/@promise. Within a transaction,\n  returns the in-transaction-value of ref, else returns the\n  most-recently-committed value of ref. When applied to a var, agent\n  or atom, returns its current state. When applied to a delay, forces\n  it if not already forced. When applied to a future, will block if\n  computation not complete. When applied to a promise, will block\n  until a value is delivered.  The variant taking a timeout can be\n  used for blocking references (futures and promises), and will return\n  timeout-val if the timeout (in milliseconds) is reached before a\n  value is available. See also - realized?.") (_la$30469 (jolt-list-pos 818 4 (jolt-vector (jolt-symbol #f "ref")) (jolt-vector (jolt-symbol #f "ref") (jolt-symbol #f "timeout-ms") (jolt-symbol #f "timeout-val"))))) (if (#3%procedure? _lp$30465) (_lp$30465 _la$30466 _la$30467 _la$30468 _la$30469 jolt-nil) (jolt-invoke _lp$30465 _la$30466 _la$30467 _la$30468 _la$30469 jolt-nil))))
