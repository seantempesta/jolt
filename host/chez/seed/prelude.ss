  (let ((_lp$30450 jv$clojure.core/attach-core-doc-meta!) (_la$30451 "clojure.core") (_la$30452 "delay?") (_la$30453 "returns true if x is a Delay created with delay") (_la$30454 (jolt-list-pos 806 4 (jolt-vector (jolt-symbol #f "x"))))) (if (#3%procedure? _lp$30450) (_lp$30450 _la$30451 _la$30452 _la$30453 _la$30454 jolt-nil) (jolt-invoke _lp$30450 _la$30451 _la$30452 _la$30453 _la$30454 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$30455 jv$clojure.core/attach-core-doc-meta!) (_la$30456 "clojure.core") (_la$30457 "deliver") (_la$30458 "Delivers the supplied value to the promise, releasing any pending\n  derefs. A subsequent call to deliver on a promise will have no effect.") (_la$30459 (jolt-list-pos 810 4 (jolt-vector (jolt-symbol #f "promise") (jolt-symbol #f "val"))))) (if (#3%procedure? _lp$30455) (_lp$30455 _la$30456 _la$30457 _la$30458 _la$30459 jolt-nil) (jolt-invoke _lp$30455 _la$30456 _la$30457 _la$30458 _la$30459 jolt-nil))))
