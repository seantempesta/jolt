(guard (e (#t #f))
  (let ((_lp$31713 jv$clojure.core/attach-core-doc-meta!) (_la$31714 "clojure.core") (_la$31715 "proxy") (_la$31716 "class-and-interfaces - a vector of class names\n\n  args - a (possibly empty) vector of arguments to the superclass\n  constructor.\n\n  f => (name [params*] body) or\n  (name ([params*] body) ([params+] body) ...)\n\n  Expands to code which creates a instance of a proxy class that\n  implements the named class/interface(s) by calling the supplied\n  fns. A single class, if provided, must be first. If not provided it\n  defaults to Object.\n\n  The interfaces names must be valid interface types. If a method fn\n  is not provided for a class method, the superclass method will be\n  called. If a method fn is not provided for an interface method, an\n  UnsupportedOperationException will be thrown should it be\n  called. Method fns are closures and can capture the environment in\n  which proxy is called. Each method fn takes an additional implicit\n  first arg, which is bound to 'this. Note that while method fns can\n  be provided to override protected methods, they have no other access\n  to protected members, nor to super, as these capabilities cannot be\n  proxied.") (_la$31717 (jolt-list-pos 882 4 (jolt-vector (jolt-symbol #f "class-and-interfaces") (jolt-symbol #f "args") (jolt-symbol #f "&") (jolt-symbol #f "fs"))))) (if (#3%procedure? _lp$31713) (_lp$31713 _la$31714 _la$31715 _la$31716 _la$31717 jolt-nil) (jolt-invoke _lp$31713 _la$31714 _la$31715 _la$31716 _la$31717 jolt-nil))))
